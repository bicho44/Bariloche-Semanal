# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION
# Proyecto Firestore configurado: 'bariloche-semanal'
FIREBASE_PROJECT_ID="bariloche-semanal"
FIREBASE_STORAGE_BUCKET="bariloche-semanal.appspot.com"
# FIREBASE_SERVICE_ACCOUNT: JSON con la clave privada de la Service Account de GCP
# IMPORTANTE: No colocar únicamente el correo electrónico. Debe ser el objeto JSON completo
# descargado de Firebase Console (Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada)
# Si no se proporciona, el sistema opera automáticamente con persistencia local real en .firestore_local
FIREBASE_SERVICE_ACCOUNT=""
